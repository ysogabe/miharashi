# miharashi-t3-remote-token@<id>.service の設定(例)。/etc/miharashi/t3-remote-token/<id>.env に置く
# (root:<実行ユーザーのグループ> 0640。秘密は入れない。実環境の値はリポジトリに入れない)。
# 項目の説明: systemd/miharashi-t3-remote-token の冒頭 / docs/t3-agent-multi-server/token-delivery.md
# T3R_SERVER_ID はユニットのインスタンス名(%i)から渡されるので、ここには書かない。

# miharashi の設定ファイル(この接続の id が [[agents.extra_servers]] にあること)
T3R_CONFIG=/etc/miharashi/config.toml
# 対象の T3 の environmentId(認証なしの GET /.well-known/t3/environment で確かめた値)
T3R_EXPECT_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000

# 既存の LXC リモート名とコンテナ名(`lxc remote list` / `lxc list <remote>:`)
T3R_LXC_REMOTE=remote-name
T3R_LXC_CONTAINER=container-name
T3R_LXC_BIN=/usr/bin/lxc

# コンテナ内で t3 を動かすユーザーと CLI(絶対パス)。exec_mode=su(既定)は `su - <user> -c '<引用した 1 本の文字列>'`。
T3R_CONTAINER_USER=ubuntu
T3R_T3_CLI=/home/ubuntu/.local/bin/t3
# シェルを通さない方式にするなら:
#T3R_EXEC_MODE=direct
#T3R_CONTAINER_USER=1000
#T3R_CONTAINER_GID=1000
#T3R_CONTAINER_HOME=/home/ubuntu

# 稼働中の miharashi の管理 API(管理ページ。設定の [admin] enabled = true と、panel.listen の origin)。
# 新しい token で稼働中の worker が取得できたことをここで観測してから、古いセッションを失効させる(必須)。
# http は IP アドレスか localhost だけ。パス・認証情報は書かない。
T3R_ADMIN_URL=http://127.0.0.1:8095
# 管理トークンのファイル(設定の [admin] token_file と同じもの。実行ユーザーの 0600、または root:実行グループの 0640。
# 値は引数・環境変数・ログに出ません。読み取り(GET)にだけ使います)
T3R_ADMIN_TOKEN_FILE=/etc/miharashi/admin.token

# この接続専用のラベル(primary の miharashi-agent-monitor は使えない)。省略すると miharashi-agent-monitor-<id>
#T3R_LABEL=miharashi-agent-monitor-container
# 発行する token の期限(省略すると T3 の既定。30 日)
#T3R_TOKEN_TTL=30d
#T3R_MIHARASHI_BIN=/usr/local/bin/miharashi
# 待ち時間(秒)。WORKER_WAIT は、稼働中の worker が新しい世代で取得するのを管理 API で待つ上限
# (worker は poll_secs ごとに取得し、token_file は 30 秒ごとに読み直す。poll_secs + 30 秒より長く)。
# 固定の待ち時間で失効することはなく、観測できなければ何も失効させずに終了コード 3 になる
#T3R_WORKER_WAIT=600
#T3R_ADMIN_POLL=3
#T3R_ADMIN_TIMEOUT=10
#T3R_EXEC_TIMEOUT=60
#T3R_RECEIVE_TIMEOUT=60
#T3R_VERIFY_TIMEOUT=90
